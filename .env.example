# AI provider: "mock" runs a fully offline, deterministic demo with no API key.
# Switch to "anthropic" later to use live Claude calls (requires ANTHROPIC_API_KEY).
AI_PROVIDER=mock

# Uploaded bid PDFs are read with AI extraction ONLY when this key is set;
# without it, deterministic rule-based extraction is used. The key stays on
# the backend and is never sent to the browser.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Model used for AI extraction of uploaded bids.
EXTRACTION_MODEL=claude-sonnet-5-5
# Per-file upload limit for bid PDFs.
MAX_UPLOAD_MB=10

# SQLite file, relative to backend/
DATABASE_URL=sqlite:///./bidguard.db

# Local file storage root, relative to backend/
STORAGE_DIR=./storage

# CORS origin for the Vite dev server
FRONTEND_ORIGIN=http://localhost:5173

# --- Officer login (prototype) --------------------------------------------
# DEMO DEFAULTS: change all of these outside a local demo.
# DEMO_MODE=true lets the login page list the demo accounts (a password is
# shown only while it is still the default below).
DEMO_MODE=true
SESSION_SECRET=demo-only-session-secret-change-me
SESSION_TTL_MINUTES=480
DEMO_OFFICER1_PASSWORD=officer-demo-1
DEMO_OFFICER2_PASSWORD=officer-demo-2
DEMO_REVIEWER_PASSWORD=reviewer-demo
